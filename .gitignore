# Ignore everything
/*

# But not these directories
!/src/
!/assets/
!/docs/
!/scripts/
!/.vscode/
!/notebooks/

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Track key docs
!README.md
!AGENT.md
!COLAB_VSCODE.md
!LICENSE
!.gitignore

# Track environment files
!environment.yml
!environment.lock.yml
!pyproject.toml
!uv.lock
# Ignore temporary scratch area
scratch/
reference/
